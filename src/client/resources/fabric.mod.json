{
	"schemaVersion": 1,
	"id": "sakchat",
	"version": "${version}",
	"name": "SAKChat",
	"description": "A modular, fully and easily configurable lightweight client-side Fabric mod built to filter, personalize and automate chat. Enjoy :D",
	"authors": [
		"Linkernel0x"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/v8plMAaV",
		"sources": "https://github.com/Linkernel0x/sakchat",
		"issues": "https://github.com/Linkernel0x/sakchat/issues"
	},
	"license": "GPLv3",
	"icon": "assets/sakchat/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"link.sakkit.sakchat.SakChatClient"
		],
		"modmenu": [
			"link.sakkit.sakchat.ui.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "sakchat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_version}",
		"cloth-config": ">=${cloth_version}"
	}
}